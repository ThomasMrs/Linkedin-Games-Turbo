{
  "manifest_version": 3,
  "name": "LinkedIn Games Solver Turbo",
  "version": "2.2.0",
  "description": "Résous rapidement les 7 jeux LinkedIn (Queens, Tango, Zip, Mini Sudoku, Patches, Wend, Sumbreak) avec mode Turbo, barre flottante et suivi quotidien.",
  "background": {
    "scripts": [
      "navigationListener.js"
    ]
  },
  "permissions": [
    "scripting",
    "activeTab",
    "webNavigation",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn Games Solver Turbo",
    "default_icon": "icon.svg"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/games/*"
      ],
      "js": [
        "pageReader.js"
      ],
      "all_frames": true,
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.linkedin.com/games/queens*"
      ],
      "js": [
        "queens.js"
      ]
    },
    {
      "matches": [
        "*://*.linkedin.com/games/zip*"
      ],
      "js": [
        "zip.js"
      ]
    },
    {
      "matches": [
        "*://*.linkedin.com/games/tango*"
      ],
      "js": [
        "tango.js"
      ]
    },
    {
      "matches": [
        "*://*.linkedin.com/games/*sudo*"
      ],
      "js": [
        "sudoku.js"
      ]
    },
    {
      "matches": [
        "*://*.linkedin.com/games/patches*"
      ],
      "js": [
        "patches.js"
      ]
    },
    {
      "matches": [
        "*://*.linkedin.com/games/wend*"
      ],
      "js": [
        "wend.js"
      ]
    },
    {
      "matches": [
        "*://*.linkedin.com/games/sumbreak*"
      ],
      "js": [
        "sumbreak.js"
      ]
    }
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "64": "icon-64.png",
    "96": "icon-96.png",
    "128": "icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "linkedin-games-solver-turbo@addons.mozilla.org",
      "strict_min_version": "128.0"
    }
  },
  "host_permissions": [
    "*://*.linkedin.com/*"
  ]
}
